# Copia este archivo a ".env" y completa tus propios valores.
# El archivo ".env" nunca se sube al repositorio (esta en .gitignore).

# Contraseña para entrar a la interfaz del CRM (un solo usuario: Fernando).
CRM_CONTRASENA=cambia-esta-contrasena

# Clave secreta para firmar la sesion del navegador. Genera una propia, por ejemplo con:
# python3 -c "import secrets; print(secrets.token_hex(32))"
CRM_CLAVE_SECRETA=cambia-esta-clave-secreta

# Zona horaria en la que trabajas. Las fechas se guardan en UTC y se muestran en esta zona.
CRM_ZONA_HORARIA=America/Caracas

# Base de datos. Por defecto un archivo SQLite dentro de crm/datos/.
# Para migrar a PostgreSQL en el servidor, cambia esta URL, por ejemplo:
# postgresql://usuario:clave@localhost:5432/crm
CRM_BASE_DATOS_URL=sqlite:///./datos/crm.db

# Meta de cobro mensual, usada en la pantalla "Hoy". Un solo numero, en dolares.
CRM_META_MENSUAL_USD=0

# --- Fase 2 (todavia no se usan en el codigo, quedan listas para cuando conectes Gmail/Sheets) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEETS_ID=
